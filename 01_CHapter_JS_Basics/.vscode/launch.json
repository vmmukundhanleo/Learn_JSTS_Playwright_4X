    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "node-terminal",
            "name": "JavaScript Debug Terminal",
            "request": "launch",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "name": "Run current JavaScript file in Terminal",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}